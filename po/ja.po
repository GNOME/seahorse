#: src/seahorse-key-manager.ui:328
msgid "Passwords and Keys"
msgstr "パスワードと鍵"

#: data/org.gnome.Seahorse.desktop.in.in:3
#: data/org.gnome.Seahorse.metainfo.xml.in.in:7
msgid "Manage your passwords and encryption keys"
msgstr "パスワードと暗号化鍵を管理"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.Seahorse.desktop.in.in:5
msgid "keyring;encryption;security;sign;ssh;gpg;pgp;seahorse;"
msgstr ""
"keyring;encryption;security;sign;ssh;gpg;pgp;seahorse;キーリング;鍵束;暗号化;"
"セキュリティ;サイン;署名;"

#: data/org.gnome.seahorse.gschema.xml:5
msgid "Default PGP Key"
msgstr "デフォルトの PGP 鍵"

#: data/org.gnome.seahorse.gschema.xml:6
msgid ""
"This specifies the ID of the default PGP key to use for certain operations, "
"mainly signing."
msgstr ""
"これは、主に署名などの特定の操作で使用するデフォルトの PGP 鍵の ID を指定しま"
"す。"

#: data/org.gnome.seahorse.gschema.xml:10
msgid "PGP key servers"
msgstr "PGP 鍵サーバー"

#: data/org.gnome.seahorse.gschema.xml:11
msgid ""
"A list of key server URIs to search for remote PGP keys. A display name can "
"be included, by appending a space and then the name."
msgstr ""
"リモート PGP 鍵を検索する鍵サーバーの URI のリスト。スペースの後に名前を追加"
"することで表示名を含めることができます。"

#: data/org.gnome.seahorse.gschema.xml:15
msgid "Auto retrieve keys"
msgstr "鍵を自動取得"

#: data/org.gnome.seahorse.gschema.xml:16
msgid "Whether or not keys should be automatically retrieved from key servers."
msgstr "鍵を鍵サーバーから自動的に取得するかどうか。"

#: data/org.gnome.seahorse.gschema.xml:20
msgid "Auto publish keys"
msgstr "鍵を自動公開"

#: data/org.gnome.seahorse.gschema.xml:21
msgid "Whether or not modified keys should be automatically published."
msgstr "変更された鍵を自動的に公開するかどうか。"

#: data/org.gnome.seahorse.gschema.xml:25
msgid "Publish keys to this key server"
msgstr "この鍵サーバーに鍵を公開する"

#: data/org.gnome.seahorse.gschema.xml:26
msgid ""
"The key server to publish PGP keys to. Or empty to suppress publishing of "
"PGP keys."
msgstr "PGP 鍵を公開する鍵サーバー。空にすると PGP 鍵の公開を無効にします。"

#: data/org.gnome.seahorse.gschema.xml:30
msgid "Last key server search pattern"
msgstr "前回の鍵サーバー検索パターン"

#: data/org.gnome.seahorse.gschema.xml:31
msgid "The last search pattern searched for against a key server."
msgstr "鍵サーバーで前回検索したパターン。"

#: data/org.gnome.seahorse.gschema.xml:35
msgid "Last key servers used"
msgstr "前回使用した鍵サーバー"

#: data/org.gnome.seahorse.gschema.xml:36
msgid ""
"The last key server a search was performed against or empty for all key "
"servers."
msgstr "前回検索した鍵サーバー。すべての鍵サーバーを対象にした場合は空。"

#: data/org.gnome.seahorse.manager.gschema.xml:5
msgid "Show keyrings sidebar"
msgstr "キーリングサイドバーを表示"

#: data/org.gnome.seahorse.manager.gschema.xml:6
msgid "Show keyrings sidebar in Seahorse."
msgstr "Seahorse にキーリングサイドバーを表示します。"

#: data/org.gnome.seahorse.manager.gschema.xml:10
msgid "Which items to show"
msgstr "表示するアイテム"

#: data/org.gnome.seahorse.manager.gschema.xml:11
msgid ""
"Filter which items to show. If empty, show all items, if “personal” show "
"personal keys, if “trusted” show trusted."
msgstr ""
"表示するアイテムをフィルターします。空の場合はすべてのアイテムを表"
"示、“personal” で個人鍵を表示、“trusted” で信頼済みを表示。"

#: data/org.gnome.seahorse.manager.gschema.xml:16
msgid "Width of the side pane"
msgstr "サイドペインの幅"

#: data/org.gnome.seahorse.manager.gschema.xml:17
msgid "The default width of the side pane."
msgstr "サイドペインのデフォルト幅。"

#: data/org.gnome.seahorse.manager.gschema.xml:21
msgid "The keyrings chosen"
msgstr "選択したキーリング"

#: data/org.gnome.seahorse.manager.gschema.xml:22
msgid "The URIs of the keyrings chosen in the sidebar."
msgstr "サイドバーで選択したキーリングの URI。"

#: data/org.gnome.seahorse.manager.gschema.xml:29
msgid "The column to sort the Seahorse keys by"
msgstr "Seahorse 鍵を並び替える列"

#: data/org.gnome.seahorse.manager.gschema.xml:30
msgid ""
"Specify the column to sort the Seahorse key manager main window by. Columns "
"are: “name”, “id”, “validity”, “expires”, “trust”, and “type”. Put a “-” in "
"front of the column name to sort in descending order."
msgstr ""
"Seahorse 鍵管理ツールのメインウィンドウで並び替える列を指定します。列は "
"“name”, “id”, “validity”, “expires”, “trust”, および “type” です。列名の前に "
"“-” を付けると降順で並び替えます。"

#: data/org.gnome.seahorse.manager.gschema.xml:34
msgid "Show validity column"
msgstr "“有効性”列を表示"

#: data/org.gnome.seahorse.manager.gschema.xml:35
#: data/org.gnome.seahorse.manager.gschema.xml:40
#: data/org.gnome.seahorse.manager.gschema.xml:45
#: data/org.gnome.seahorse.manager.gschema.xml:50
msgid "No longer in use."
msgstr "使用されていません。"

#: data/org.gnome.seahorse.manager.gschema.xml:39
msgid "Show expiry column"
msgstr "“有効期限”列を表示"

#: data/org.gnome.seahorse.manager.gschema.xml:44
msgid "Show trust column"
msgstr "“信頼度”列を表示"

#: data/org.gnome.seahorse.manager.gschema.xml:49
msgid "Show type column"
msgstr "“種類”列を表示"

#: data/org.gnome.Seahorse.metainfo.xml.in.in:9
msgid "Passwords and Keys is a GNOME application for managing encryption keys."
msgstr "“パスワードと鍵”は暗号鍵を管理するための GNOME アプリケーションです。"

#: data/org.gnome.Seahorse.metainfo.xml.in.in:12
msgid ""
"With Passwords and Keys you can create and manage PGP keys, create and "
"manage SSH keys, publish and retrieve keys from key servers, cache your "
"passphrase so you don’t have to keep typing it and backup your keys and "
"keyring."
msgstr ""
"\"パスワードと鍵\"を使用すると PGP 鍵や SSH 鍵の生成と管理、鍵サーバーへの公"
"開と取得、パスフレーズのキャッシュによる入力の省略、鍵とキーリングのバック"
"アップが行えます。"

#: data/org.gnome.Seahorse.metainfo.xml.in.in:22
msgid "Main Window"
msgstr "メインウインドウ"

